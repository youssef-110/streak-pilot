{
  "name": "streak-pilot",
  "version": "2.0.0",
  "private": true,
  "description": "Schedule real GitHub commits at exact times, from a hosted dashboard. Sign in with GitHub, pick a repo, done.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute streak-pilot --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute streak-pilot --local --file=schema.sql",
    "test": "node --test test/*.test.js"
  },
  "devDependencies": {
    "wrangler": "^4.156.0"
  }
}
